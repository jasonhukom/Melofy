# Copy this file to .env for local development and fill in what you need.
# In production (Vercel etc.) set these as real environment variables in
# the project's dashboard instead of committing a .env file.

# --- Django -----------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=

# Public URL of this deployment, no trailing slash (used to build the
# Google OAuth redirect URI). Update this after your first deploy.
PUBLIC_BASE_URL=http://127.0.0.1:8000

# --- Database -----------------------------------------------------------
# Leave blank for local SQLite. On Vercel (or any serverless host) set this
# to a hosted Postgres connection string — SQLite's file won't persist
# reliably there. Vercel Postgres, Neon, and Supabase all have free tiers.
DATABASE_URL=

# --- YouTube Data API v3 (server-side only, never sent to the browser) ---
# Google Cloud Console -> APIs & Services -> Credentials -> Create API key.
# If you ever pasted a key somewhere public (a chat, a commit, a
# screenshot), regenerate it before putting it here.
YOUTUBE_API_KEY=

# --- Google OAuth client, for "Connect your YouTube account" -----------
# Google Cloud Console -> Credentials -> Create Credentials -> OAuth client
# ID -> Web application. Authorized redirect URI must be exactly:
#   <PUBLIC_BASE_URL>/api/youtube/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Firebase (server-side token verification for "Sign in with Google") -
# Firebase Console -> Project settings -> Service accounts -> Generate new
# private key. Paste the entire downloaded JSON file's content here as one
# line.
FIREBASE_SERVICE_ACCOUNT_JSON=
